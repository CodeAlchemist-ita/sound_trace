# Copia questo file in .env.local e compila i valori. .env.local non va mai committato.
# Le variabili EXPO_PUBLIC_* vengono inserite nell'app al momento della build: dopo averle
# cambiate riavvia Metro (npx expo start -c) oppure ricompila l'app.

# OBBLIGATORIA. Client ID dell'app creata su https://developer.spotify.com/dashboard
# (e' pubblico: il login usa PKCE, il Client Secret non serve e non va messo).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# FACOLTATIVA. URL della funzione "sync" del tuo progetto Supabase:
# https://<project-ref>.supabase.co/functions/v1/sync
# Senza, l'app funziona solo in locale (niente sync telefono/PC, amici, sync sul server, traduzione).
EXPO_PUBLIC_SYNC_URL=

# FACOLTATIVE. Se vuote vengono ricavate da EXPO_PUBLIC_SYNC_URL sostituendo "/sync"
# con "/token", "/friends", "/register", "/translate". Servono solo se le funzioni
# stanno in un altro indirizzo.
# Funzione "token" (consegna del refresh token e sync sul server):
EXPO_PUBLIC_TOKEN_URL=
# Funzione "friends" (amici, in riproduzione ora degli amici, consigli, privacy):
EXPO_PUBLIC_FRIENDS_URL=
# Funzione "register" (registrazione con l'email dell'account Spotify):
EXPO_PUBLIC_REGISTER_URL=
# Funzione "translate" (traduzione dei testi con DeepL):
EXPO_PUBLIC_TRANSLATE_URL=
